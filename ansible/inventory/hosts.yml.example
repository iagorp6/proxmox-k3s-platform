all:
  children:
    proxmox:
      hosts:
        pve-01:
          ansible_host: 192.168.10.10
          ansible_user: root
          k3s_vm_id: 100   # VMID da VM do K3s (terraform output vm_id): playbooks/k3s.yml tira snapshot dela antes de upgrade
          # role pve_host: redes que acessam GUI/SSH e quem coleta os exporters (a VM do K3s)
          pve_host_firewall_management: ["192.168.10.0/24"]
          pve_host_firewall_scrape_sources: ["192.168.10.20"]
    k3s:
      hosts:
        k3s-01:
          ansible_host: 192.168.10.20
