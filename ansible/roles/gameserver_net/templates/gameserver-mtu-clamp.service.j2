[Unit]
Description=Drop oversized inbound game UDP to force small RakNet MTU (avoid fragmentation)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'iptables -t raw -C PREROUTING -i {{ gameserver_iface }} -p udp -m multiport --dports {{ gameserver_udp_ports | join(",") }} -m length --length {{ gameserver_max_inbound_len + 1 }}:65535 -j DROP 2>/dev/null || iptables -t raw -I PREROUTING -i {{ gameserver_iface }} -p udp -m multiport --dports {{ gameserver_udp_ports | join(",") }} -m length --length {{ gameserver_max_inbound_len + 1 }}:65535 -j DROP'
ExecStop=/bin/sh -c 'iptables -t raw -D PREROUTING -i {{ gameserver_iface }} -p udp -m multiport --dports {{ gameserver_udp_ports | join(",") }} -m length --length {{ gameserver_max_inbound_len + 1 }}:65535 -j DROP 2>/dev/null || true'

[Install]
WantedBy=multi-user.target
